{{!--
  POST-CARD — Tarjeta de artículo reutilizable
  Spec: kb/docs/blog-index.md, blog-post.md
  Uso: index.hbs, tag.hbs, related-posts.hbs
--}}
<article class="post-card">
  <a href="{{url}}" class="post-card__link" tabindex="-1" aria-hidden="true">
    {{#if feature_image}}
      <div class="post-card__image-wrapper">
        <img src="{{img_url feature_image size="m"}}"
             alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}Imagen del artículo: {{title}}{{/if}}"
             width="600" height="338"
             loading="lazy"
             class="post-card__image">
      </div>
    {{else}}
      <div class="post-card__image-wrapper post-card__image-wrapper--no-image" aria-hidden="true"></div>
    {{/if}}
  </a>

  <div class="post-card__body">
    {{!-- Badge de categoría --}}
    {{#primary_tag}}
      <a href="{{url}}" class="badge badge--primary post-card__tag" data-gtm="blog_category_click">
        {{name}}
      </a>
    {{/primary_tag}}

    {{!-- Título enlazable --}}
    <h3 class="post-card__title">
      <a href="{{url}}" class="post-card__title-link" data-gtm="blog_article_click">
        {{title}}
      </a>
    </h3>

    {{!-- Excerpt --}}
    {{#if custom_excerpt}}
      <p class="post-card__excerpt">{{custom_excerpt}}</p>
    {{else if excerpt}}
      <p class="post-card__excerpt">{{excerpt characters="140"}}</p>
    {{/if}}

    {{!-- Metadata --}}
    <div class="post-card__meta">
      <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D [de] MMMM [de] YYYY"}}</time>
      <span class="post-card__meta-sep" aria-hidden="true">·</span>
      <span>{{reading_time minute="1 min" minutes="% min"}}</span>
    </div>
  </div>
</article>
