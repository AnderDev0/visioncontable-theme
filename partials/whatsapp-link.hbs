{{!--
  WHATSAPP-LINK — Enlace único a WhatsApp Business (fuente de verdad del número)

  El número sale del panel de Ghost (Diseño → Custom → whatsapp_number) y cae al
  número oficial cuando el campo está vacío. Antes cada CTA iba envuelto en
  {{#if @custom.whatsapp_number}}: con el campo sin diligenciar, TODOS los CTA de
  WhatsApp del sitio desaparecían del HTML. Con el respaldo ya no puede pasar.

  Uso:
    {{> whatsapp-link
        message="Hola%2C%20Katerinn..."                     (URL-encoded; opcional)
        class="btn btn--primary btn--lg"                     (opcional)
        text="Hablar con Katerinn"                           (opcional)
        label="Hablar con Katerinn por WhatsApp (abre en nueva pestaña)"  (opcional)
        gtm="click_whatsapp_hero"                            (opcional)
        icon=true}                                           (opcional)
--}}
<a href="https://wa.me/{{#if @custom.whatsapp_number}}{{@custom.whatsapp_number}}{{else}}573238325800{{/if}}?text={{#if message}}{{message}}{{else}}Hola%2C%20Katerinn.%20Quiero%20recibir%20orientaci%C3%B3n%20sobre%20tus%20servicios...{{/if}}"
   class="{{#if class}}{{class}}{{else}}btn btn--primary{{/if}}"
   target="_blank"
   rel="noopener noreferrer"
   aria-label="{{#if label}}{{label}}{{else}}Hablar con Katerinn por WhatsApp (abre en nueva pestaña){{/if}}"
   {{#if gtm}}data-gtm="{{gtm}}"{{/if}}>
