{{!-- HERO — con imagen de fondo.
     La imagen se pasa por variable CSS para poder usar el helper {{asset}};
     cambiar la foto definitiva es cambiar sólo el nombre del archivo aquí. --}}
<section class="landing-hero landing-hero--media section--lg">
  {{!-- Dos fotos en fundido cruzado, decorativas: el significado lo carga el
       H1, por eso van con alt vacio y el bloque aria-hidden. Solo la primera
       se carga de inmediato; la segunda va diferida. --}}
  <div class="landing-hero__media" aria-hidden="true">
    <img class="landing-hero__photo" src="{{asset "images/Asesoria_tributaria.webp"}}"
         srcset="{{asset "images/Asesoria_tributaria-1200.webp"}} 1200w, {{asset "images/Asesoria_tributaria.webp"}} 2000w"
         sizes="(max-width: 767px) 400px, 2000px" alt=""
         width="2000" height="1333" loading="eager" fetchpriority="high">
    <img class="landing-hero__photo" src="{{asset "images/Asesoria_financiera.webp"}}"
         srcset="{{asset "images/Asesoria_financiera-1200.webp"}} 1200w, {{asset "images/Asesoria_financiera.webp"}} 2000w"
         sizes="(max-width: 767px) 400px, 2000px" alt=""
         width="2000" height="1333" loading="lazy" decoding="async">
  </div>
  <div class="container">
    <div class="landing-hero__inner">
      <div class="landing-hero__text">
        <h1 class="landing-hero__title">Trámites y asesorías en temas contables, tributarios y financieros</h1>
        <p class="landing-hero__subtitle text-lead">
          Resuelvo situaciones puntuales de tu negocio o empresa sin necesidad de un contrato mensual. Rápido, claro y con el resultado que necesitas.
        </p>
        {{> whatsapp-link
            message="Hola%2C%20Katerinn.%20Quiero%20consultar%20un%20tr%C3%A1mite%20o%20una%20asesor%C3%ADa%20contable%20o%20tributaria..."
            class="btn btn--primary btn--lg"
            label="Consultar servicio especializado con Katerinn por WhatsApp (abre en nueva pestaña)"
            gtm="click_whatsapp_hero"}}
      </div>
    </div>
  </div>
</section>

{{!-- INTRO DEL SERVICIO --}}
<section class="landing-intro section section--bg-surface">
  <div class="container container--narrow">
    {{!-- H2 requerido por kb/docs/services-specialized.md §3.2: la sección no
         tenía encabezado, quedaba como un párrafo suelto en el outline. --}}
    <h2 class="landing-intro__title">Encuentra la orientación que necesitas para resolver tu caso</h2>
    <p class="landing-intro__text">
      Si tienes una situación tributaria que resolver, necesitas una consulta puntual o tienes un trámite específico, esta es la ruta adecuada. No se requiere compromiso mensual: trabajamos juntos exactamente en lo que necesitas.
    </p>
  </div>
</section>

{{!-- 7 SERVICIOS ESPECIALIZADOS
     Índice editorial agrupado por el momento en que está el cliente, en vez de
     una rejilla plana de 7 tarjetas iguales: así se lee como 3 decisiones y no
     como 7 bloques indistintos. Copys tomados de kb/docs/services-specialized.md §3.3.
     Regla de fase 1: bloques informativos, sin <a> ni cursor de enlace. --}}
<section class="landing-services section">
  <div class="container">
    <div class="section-header">
      <h2>Servicios según lo que necesitas resolver</h2>
      <p>Revisa las opciones disponibles. Si no tienes claro cuál corresponde a tu caso, puedes contarme qué necesitas y recibir orientación sobre el siguiente paso.</p>
    </div>

    <div class="service-index" data-reveal>

      <div class="service-index__group">
        <p class="service-index__eyebrow">Entender tu situación</p>
        <ul class="service-index__list" role="list">
          <li class="service-index__item">
            <h3 class="service-index__title">Asesoría contable, tributaria o financiera</h3>
            <p class="service-index__desc">Sesión de orientación para revisar una duda o situación específica, entender su alcance y definir los pasos que conviene seguir.</p>
          </li>
          <li class="service-index__item">
            <h3 class="service-index__title">Diagnóstico tributario empresarial</h3>
            <p class="service-index__desc">Revisión inicial de la situación tributaria de una empresa para identificar obligaciones, asuntos que requieren atención y prioridades de trabajo.</p>
          </li>
        </ul>
      </div>

      <div class="service-index__group">
        <p class="service-index__eyebrow">Cumplir tus obligaciones</p>
        <ul class="service-index__list" role="list">
          <li class="service-index__item">
            <h3 class="service-index__title">Declaración de renta para personas naturales</h3>
            <p class="service-index__desc">Acompañamiento en la revisión de la información y la preparación de la declaración de renta, de acuerdo con la situación particular de cada persona.</p>
          </li>
          <li class="service-index__item">
            <h3 class="service-index__title">Implementación de facturación electrónica</h3>
            <p class="service-index__desc">Orientación y acompañamiento para configurar la facturación electrónica y organizar los requisitos básicos del proceso.</p>
          </li>
          <li class="service-index__item">
            <h3 class="service-index__title">Actualización del RUT</h3>
            <p class="service-index__desc">Apoyo para revisar y actualizar la información registrada en el RUT de acuerdo con los cambios o necesidades de la persona o empresa.</p>
          </li>
        </ul>
      </div>

      <div class="service-index__group">
        <p class="service-index__eyebrow">Decidir con criterio</p>
        <ul class="service-index__list" role="list">
          <li class="service-index__item">
            <h3 class="service-index__title">Planeación tributaria</h3>
            <p class="service-index__desc">Análisis y orientación para anticipar obligaciones, organizar decisiones tributarias y reducir la improvisación dentro del marco normativo aplicable.</p>
          </li>
          <li class="service-index__item">
            <h3 class="service-index__title">Gerencia financiera externa</h3>
            <p class="service-index__desc">Acompañamiento para empresas que necesitan análisis, seguimiento y criterio profesional para tomar decisiones financieras sin incorporar una gerencia interna.</p>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

