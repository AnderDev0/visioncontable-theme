{{!< default}}
{{!--
  PAGE.HBS — Plantilla genérica de fallback para páginas estáticas
  Usado cuando una página no tiene una plantilla más específica asignada.
  Los datos de la página llegan dentro de "page" (de ahí el bloque {{#page}}).
--}}

{{#page}}
{{> breadcrumbs}}

<article class="generic-page">
  <div class="container container--narrow">
    <header class="generic-page__header">
      <h1 class="generic-page__title">{{title}}</h1>
    </header>

    {{#if feature_image}}
      <div class="generic-page__hero-image">
        <img src="{{img_url feature_image size="l"}}"
             alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
             width="800" height="450"
             loading="eager"
             class="generic-page__image">
      </div>
    {{/if}}

    {{#if content}}
    <div class="generic-page__content gh-content">
      {{content}}
    </div>
    {{/if}}
  </div>
</article>
{{/page}}
