{{!-- HERO — con imagen de fondo.
     La imagen se pasa por variable CSS para poder usar el helper {{asset}};
     cambiar la foto definitiva es cambiar sólo el nombre del archivo aquí. --}}
<section class="landing-hero landing-hero--media section--lg">
  {{!-- Dos fotos en fundido cruzado, decorativas: el significado lo carga el
       H1, por eso van con alt vacio y el bloque aria-hidden. Solo la primera
       se carga de inmediato; la segunda va diferida. --}}
  <div class="landing-hero__media" aria-hidden="true">
    <img class="landing-hero__photo" src="{{asset "images/Gestion_pymes.webp"}}"
         srcset="{{asset "images/Gestion_pymes-1200.webp"}} 1200w, {{asset "images/Gestion_pymes.webp"}} 2000w"
         sizes="(max-width: 767px) 400px, 2000px" alt=""
         width="2000" height="1333" loading="eager" fetchpriority="high">
    <img class="landing-hero__photo" src="{{asset "images/Contabilidad_pymes.webp"}}"
         srcset="{{asset "images/Contabilidad_pymes-1200.webp"}} 1200w, {{asset "images/Contabilidad_pymes.webp"}} 2000w"
         sizes="(max-width: 767px) 400px, 2000px" alt=""
         width="2000" height="1125" loading="lazy" decoding="async">
  </div>
  <div class="container">
    <div class="landing-hero__inner">
      <div class="landing-hero__text">
        <h1 class="landing-hero__title">Contabilidad al día para que tu empresa no se detenga</h1>
        <p class="landing-hero__subtitle text-lead">
          Gestión contable mensual para empresas activas. Me encargo de que tus registros estén al día, tus impuestos presentados y tus estados financieros listos cuando los necesites.
        </p>
        {{> whatsapp-link
            message="Hola%2C%20Katerinn.%20Quiero%20consultar%20el%20servicio%20de%20gesti%C3%B3n%20contable%20para%20mi%20empresa..."
            class="btn btn--primary btn--lg"
            label="Consultar gestión contable con Katerinn por WhatsApp (abre en nueva pestaña)"
            gtm="click_whatsapp_hero"}}
      </div>
    </div>
  </div>
</section>

{{!-- 8 COMPONENTES DEL SERVICIO --}}
<section class="landing-services section">
  <div class="container">
    <div class="section-header">
      <h2>¿Qué incluye la gestión contable mensual?</h2>
    </div>
    {{!--
      Checklist de inclusiones agrupado por RITMO (cada mes / por período /
      cuando se necesita), no por tema. Aquí el cliente no elige un servicio
      —contrata un solo plan mensual—, así que el trabajo del bloque no es
      ayudarlo a decidir sino que perciba todo lo que recibe. De ahí la
      palomita en cada línea ("esto ya está incluido") y el fraccionar 8 ítems
      en 3 grupos, que es lo que los vuelve abarcables de una sola lectura.
    --}}
    <div class="includes" data-reveal>

      <div class="includes__group">
        <p class="includes__rhythm">Cada mes</p>
        <ul class="includes__list" role="list">
          <li class="includes__item">
            <h3 class="includes__title">Registro contable mensual</h3>
            <p class="includes__desc">Clasificación y registro de todas las transacciones del período en el sistema contable.</p>
          </li>
          <li class="includes__item">
            <h3 class="includes__title">Conciliaciones bancarias</h3>
            <p class="includes__desc">Verificación de que los movimientos bancarios coincidan con los registros contables.</p>
          </li>
          <li class="includes__item">
            <h3 class="includes__title">Seguimiento de obligaciones</h3>
            <p class="includes__desc">Control de fechas de vencimiento para que no haya sanciones por presentación tardía.</p>
          </li>
        </ul>
      </div>

      <div class="includes__group">
        <p class="includes__rhythm">Cada período</p>
        <ul class="includes__list" role="list">
          <li class="includes__item">
            <h3 class="includes__title">Liquidación de impuestos</h3>
            <p class="includes__desc">Cálculo y elaboración de declaraciones de IVA, retención en la fuente e ICA según periodicidad.</p>
          </li>
          <li class="includes__item">
            <h3 class="includes__title">Estados financieros</h3>
            <p class="includes__desc">Balance general, estado de resultados y estado de flujo de caja con periodicidad acordada.</p>
          </li>
          <li class="includes__item">
            <h3 class="includes__title">Indicadores financieros básicos</h3>
            <p class="includes__desc">Análisis de indicadores clave para que puedas leer la salud financiera de tu empresa.</p>
          </li>
        </ul>
      </div>

      <div class="includes__group">
        <p class="includes__rhythm">Cuando lo necesitas</p>
        <ul class="includes__list" role="list">
          <li class="includes__item">
            <h3 class="includes__title">Soporte para declaración de renta</h3>
            <p class="includes__desc">Preparación de la información necesaria para la declaración de renta anual de la empresa.</p>
          </li>
          <li class="includes__item">
            <h3 class="includes__title">Soporte ante requerimientos</h3>
            <p class="includes__desc">Acompañamiento ante solicitudes de información de la DIAN o auditorías relacionadas con períodos gestionados.</p>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

{{!-- PROCESO MENSUAL (5 pasos) --}}
<section class="landing-process section section--bg-warm roadmap-pin">
  <div class="container">
    <div class="section-header">
      <h2>Cómo funciona mes a mes</h2>
    </div>
    <ol class="landing-process__steps roadmap roadmap--5" role="list" data-reveal>
      <li class="home-process__step">
        <span class="home-process__number" aria-hidden="true">01</span>
        <h3 class="home-process__step-title">Recopilación de documentos</h3>
        <p class="home-process__step-desc">Al inicio del mes me compartes facturas, extractos y demás soporte del período anterior.</p>
      </li>
      <li class="home-process__step">
        <span class="home-process__number" aria-hidden="true">02</span>
        <h3 class="home-process__step-title">Registro y clasificación</h3>
        <p class="home-process__step-desc">Proceso todos los movimientos y los registro en el sistema contable de la empresa.</p>
      </li>
      <li class="home-process__step">
        <span class="home-process__number" aria-hidden="true">03</span>
        <h3 class="home-process__step-title">Liquidación de impuestos</h3>
        <p class="home-process__step-desc">Calculo los impuestos del período y elaboro las declaraciones correspondientes.</p>
      </li>
      <li class="home-process__step">
        <span class="home-process__number" aria-hidden="true">04</span>
        <h3 class="home-process__step-title">Entrega de reportes</h3>
        <p class="home-process__step-desc">Te envío los estados financieros e indicadores del período de forma clara y organizada.</p>
      </li>
      <li class="home-process__step">
        <span class="home-process__number" aria-hidden="true">05</span>
        <h3 class="home-process__step-title">Revisión y consultas</h3>
        <p class="home-process__step-desc">Resolvemos juntos cualquier duda sobre los reportes o la situación financiera del mes.</p>
      </li>

    </ol>
  </div>
</section>

{{!-- TABLA DE RESPONSABILIDADES COMPARTIDAS --}}
<section class="landing-responsibilities section">
  <div class="container container--narrow">
    <div class="section-header">
      <h2>¿Qué hace cada parte?</h2>
      <p>Para que el servicio funcione bien, trabajamos juntos.</p>
    </div>
    <div class="landing-responsibilities__table-wrapper">
      <table class="landing-responsibilities__table">
        <caption class="sr-only">Tabla de responsabilidades: qué hace Katerinn y qué hace la empresa</caption>
        <thead>
          <tr>
            <th scope="col">Katerinn</th>
            <th scope="col">Tu empresa</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Registra y clasifica todas las transacciones</td>
            <td>Comparte documentos completos y a tiempo</td>
          </tr>
          <tr>
            <td>Elabora y programa las declaraciones tributarias</td>
            <td>Paga los impuestos en los plazos establecidos</td>
          </tr>
          <tr>
            <td>Genera los estados financieros periódicos</td>
            <td>Revisa y aprueba los reportes compartidos</td>
          </tr>
          <tr>
            <td>Alerta sobre obligaciones y vencimientos</td>
            <td>Responde oportunamente a las solicitudes de información</td>
          </tr>
          <tr>
            <td>Acompaña ante requerimientos de la DIAN</td>
            <td>Informa sobre cambios en el negocio que afecten la contabilidad</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

