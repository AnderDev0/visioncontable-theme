{{!< default}}
{{!--
  POST.HBS — Artículo de blog (/blog/{slug}/)
  Spec: kb/docs/blog-post.md
  Estructura: Breadcrumbs | Badge | Hero 16:9 | Metadata |
              ToC condicional | Aviso tributario | Contenido |
              Fuentes | Bio autor | Relacionados | Copy link | CTA WhatsApp
--}}

{{!-- Ghost entrega el artículo dentro de "post": sin este bloque, title,
     content, fechas, primary_tag, etc. salen vacíos (H1 vacío en producción). --}}
{{#post}}
<article class="post-article">

  {{!-- Breadcrumbs (4 niveles: Inicio > Blog > Categoría > Título) --}}
  <div class="container">
    {{> breadcrumbs}}
  </div>

  {{!-- Header del artículo --}}
  <header class="post-header">
    <div class="container container--narrow">

      {{!-- Badge de categoría --}}
      {{#primary_tag}}
        <a href="{{url}}" class="badge badge--primary post-header__badge" data-gtm="blog_category_click">
          {{name}}
        </a>
      {{/primary_tag}}

      {{!-- H1 del artículo --}}
      <h1 class="post-header__title">{{title}}</h1>

      {{!-- Excerpt / descripción --}}
      {{#if custom_excerpt}}
        <p class="post-header__excerpt">{{custom_excerpt}}</p>
      {{/if}}

      {{!-- Metadata: autor, fecha publicación, fecha actualización, tiempo lectura --}}
      <div class="post-header__meta">
        {{#foreach authors}}
          <span class="post-header__author">
            {{#if profile_image}}
              <img src="{{img_url profile_image size="xxs"}}"
                   alt="{{name}}"
                   width="28" height="28"
                   loading="lazy"
                   class="post-header__author-avatar">
            {{/if}}
            <a href="/katerinn-romero/" class="post-header__author-link" data-gtm="blog_about_click">{{name}}</a>
          </span>
        {{/foreach}}
        <span class="post-header__meta-sep" aria-hidden="true">·</span>
        <time datetime="{{date format="YYYY-MM-DD"}}" class="post-header__date">
          {{date format="D [de] MMMM [de] YYYY"}}
        </time>
        {{#if updated_at}}
          {{!-- Fecha de actualización solo si es distinta a la de publicación --}}
          <span class="post-header__meta-sep" aria-hidden="true">·</span>
          <span class="post-header__updated">
            Actualizado: <time datetime="{{date updated_at format="YYYY-MM-DD"}}">{{date updated_at format="D MMM YYYY"}}</time>
          </span>
        {{/if}}
        <span class="post-header__meta-sep" aria-hidden="true">·</span>
        <span class="post-header__reading-time">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
      </div>

    </div>
  </header>

  {{!-- Imagen hero (16:9, no lazy loading — above fold) --}}
  {{#if feature_image}}
    <div class="post-hero-image container">
      <figure class="post-hero-image__figure">
        <img src="{{img_url feature_image size="xl"}}"
             alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
             width="1200" height="675"
             loading="eager"
             class="post-hero-image__img">
        {{#if feature_image_caption}}
          <figcaption class="post-hero-image__caption">{{feature_image_caption}}</figcaption>
        {{/if}}
      </figure>
    </div>
  {{/if}}

  {{!-- Contenido del artículo + componentes laterales --}}
  <div class="post-layout container">

    <div class="post-content-area">

      {{!-- Aviso tributario contextual (inyectado desde el contenido del post via clase) --}}
      {{!-- El redactor puede añadir una callout con clase .aviso-tributario en el editor de Ghost --}}

      {{!-- Cuerpo del artículo --}}
      <div class="post-body gh-content">
        {{content}}
      </div>

      {{!-- Botón copiar enlace --}}
      <div class="post-copy-link">
        <button class="btn btn--outline btn--sm post-copy-link__btn"
                id="copy-link-btn"
                aria-label="Copiar enlace del artículo"
                data-gtm="blog_copy_link"
                data-url="{{url absolute="true"}}">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>
          </svg>
          <span class="post-copy-link__text">Copiar enlace</span>
        </button>
      </div>

      {{!-- Bio del autor --}}
      {{> author-bio}}

    </div>

  </div>

  {{!-- Artículos relacionados --}}
  <div class="post-related container">
    {{> related-posts}}
  </div>

  {{!-- CTA WhatsApp contextual --}}
  <div class="post-whatsapp-cta container">
    <div class="post-whatsapp-cta__inner">
      <p class="post-whatsapp-cta__text">
        ¿Tienes preguntas sobre lo que acabas de leer? Consúltame directamente.
      </p>
      {{> whatsapp-link
          message="Hola%2C%20Katerinn.%20Estuve%20leyendo%20tu%20art%C3%ADculo%20y%20quiero%20recibir%20orientaci%C3%B3n%20sobre..."
          class="btn btn--primary"
          text="Hablemos por WhatsApp"
          gtm="blog_whatsapp_click"}}
    </div>
  </div>

</article>
{{/post}}

{{!-- El JSON-LD del post lo inyecta default.hbs en el <head> (contexto "post");
     incluirlo también aquí duplicaba el BlogPosting. --}}
